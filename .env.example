# --- Supabase (required for live data; the app degrades to an empty state without it) ---
# Public read is restricted by RLS to approved demo rows only. Submissions and the
# moderation queue are never publicly readable.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# --- OpenAI (optional) ---
# Powers the Ask Kena Scam chatbot, natural-language search, "Auto-tag my tea",
# the weekly digest generator and Final Boss text-to-speech. Every one of those
# has a polished local fallback, so the site is fully functional with no key.
# Server-side only — never exposed to the browser.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
# Built-in OpenAI voices only. Never cloned, never modelled on a real person.
# The coach and the scam voice differ so they are never confusable.
# Spoken accent for the awareness-game audio: "my" (Malaysian) or "sg" (Singaporean).
KENA_TTS_ACCENT="my"
OPENAI_TTS_VOICE_COACH="ballad"
OPENAI_TTS_VOICE_TRAP="ash"
# Process-wide ceiling so a bug cannot drain a prepaid balance.
OPENAI_DAILY_CALL_CAP="500"
